+test('UI regression QA-F-001: pending submit retains focus and blocks duplicate mutations', async () => {
+  const data = browserTasks('2027-01-01');
+  let release;
+  const pending = new Promise(resolve => { release = resolve; });
+  const h = browserHarness([browserTasks(), pending, data]); await h.flush();
+  const form = h.child(h.item(0), 'form'); const button = h.child(form, 'button');
+  h.child(form, 'input').value = '2027-01-01'; button.focus();
+  const submission = h.submit(0); await h.flush();
+  assert.equal(h.doc.activeElement, button);
+  assert.equal(button.disabled, false);
+  assert.equal(button.ariaDisabled, 'true');
+  await form.listeners.submit({ preventDefault() {} });
+  assert.equal(h.requests.filter(request => request.options?.method === 'POST').length, 1);
+  release({ task: data.tasks[0] }); await submission;
+  assert.equal(h.doc.activeElement, h.child(h.item(0), 'h2'));
+});
